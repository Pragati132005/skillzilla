# Copy to .env (never commit .env). Use the Supabase *anon* key if RLS allows reads on the table,
# otherwise the service-role key -- but ONLY on a server, never in browser code.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_KEY=YOUR-KEY
# Table that holds the company requirement rows (columns: id, companies, coding, ... operating_system)
SUPABASE_COMPANY_TABLE=staging_company_skill_levels
# Optional: table holding the level rubric (id, skill_area, levels, topics). If unset the bundled CSV is used.
# SUPABASE_RUBRIC_TABLE=staging_skill_levels
# auto = Supabase when configured, else local CSV | supabase | csv
TALENT_CHECK_SOURCE=auto
# 1 = never fall back to the local CSV when Supabase fails (recommended for the final demo data check)
TALENT_CHECK_STRICT_SOURCE=0
TALENT_CHECK_CACHE_TTL=300
TALENT_CHECK_HOST=127.0.0.1
TALENT_CHECK_PORT=8010
TALENT_CHECK_CORS_ORIGINS=http://localhost:5173,http://localhost:3000
